    "@sextant/analytics": "workspace:*",
    "@sextant/email": "workspace:*",
    "@sextant/seo": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "^1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^0.562.0",
    "marked": "^18.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
