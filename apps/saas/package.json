{
  "name": "@sextant/saas",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "predev": "node scripts/generate-commits.mjs",
    "generate-routes": "vite build",
    "generate:commits": "node scripts/generate-commits.mjs",
    "prebuild": "node scripts/generate-commits.mjs",
