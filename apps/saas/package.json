  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.162.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
