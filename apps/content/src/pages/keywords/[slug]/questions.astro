---
import Base from "../../../layouts/Base.astro";
import { faqLd, questionPath } from "../../../lib/geo";
import { KEYWORDS, type KeywordRow } from "../../../data/keywords";

export function getStaticPaths() {
  return KEYWORDS.map((row) => ({ params: { slug: row.slug }, props: { row } }));
}

interface Props {
  row: KeywordRow;
}

const { row } = Astro.props;
const title = `${row.keyword}: Questions`;
const description = `Common questions about ${row.keyword}.`;
---

<Base
  title={title}
  description={description}
  path={`/keywords/${row.slug}/questions`}
  jsonLd={faqLd(row)}
>
  <article>
    <nav class="text-sm text-ink-3">
      <a
        class="text-ink-3 underline decoration-border-strong underline-offset-2 transition-colors hover:text-signal hover:decoration-signal"
        href="/keywords"
      >
        Topics
      </a>
      <span class="mx-1.5 text-ink-4">/</span>
      <a
        class="text-ink-3 underline decoration-border-strong underline-offset-2 transition-colors hover:text-signal hover:decoration-signal"
        href={`/keywords/${row.slug}`}
      >
        {row.keyword}
      </a>
      <span class="mx-1.5 text-ink-4">/</span>
      <span class="text-ink-2">Questions</span>
    </nav>

    <p class="label-caps mt-6 text-signal">Q&amp;A</p>
    <h1 class="display-type mt-3 text-4xl font-medium text-ink sm:text-5xl">
      {row.keyword}: common questions
    </h1>

    <dl class="mt-10 divide-y divide-border border-y border-border">
      {row.faq.map((entry) => (
        <div class="group py-5 first:pt-0 last:pb-0">
          <dt class="text-base font-medium text-ink">
            <a
              class="flex items-start justify-between gap-4 transition-colors hover:text-signal"
              href={questionPath(row, entry.question)}
            >
              <span>{entry.question}</span>
              <span
                aria-hidden="true"
                class="mt-0.5 shrink-0 text-ink-4 transition-all duration-150 group-hover:translate-x-0.5 group-hover:text-signal"
              >
                →
              </span>
            </a>
          </dt>
          <dd class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-2">{entry.answer}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-10 text-sm">
      <a
        class="inline-flex items-center gap-1.5 font-medium text-signal transition-colors hover:text-signal-hover"
        href={`/keywords/${row.slug}`}
      >
        <span aria-hidden="true">←</span> Read the {row.keyword} overview
      </a>
    </p>
  </article>
</Base>
