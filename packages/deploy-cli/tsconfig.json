{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package compiles to dist/ and runs on plain Node, so it overrides
    // the base config's typecheck-only settings.
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
